{
  "name": "agent-ui-kit",
  "version": "0.1.1",
  "description": "Point at an element in your running app, say what is wrong — the note lands in a file your coding agent reads.",
  "keywords": [
    "vite-plugin",
    "ai",
    "agent",
    "feedback",
    "annotate",
    "claude",
    "cursor",
    "devtools"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsen-ask-lx/agent-ui-kit.git"
  },
  "homepage": "https://github.com/arsen-ask-lx/agent-ui-kit#readme",
  "bugs": {
    "url": "https://github.com/arsen-ask-lx/agent-ui-kit/issues"
  },
  "scripts": {
    "test": "node --test",
    "example": "vite --config example/vite.config.js example"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  }
}
